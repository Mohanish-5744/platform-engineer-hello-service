# Copy to terraform.tfvars (git-ignored).
aws_region    = "ap-south-1"
instance_type = "t3.micro" # t2.micro for accounts created before 15 Jul 2025
app_version   = "1.0.0"

# Restrict HTTP to your IP while testing (curl -s https://checkip.amazonaws.com):
# allowed_http_cidrs = ["203.0.113.10/32"]

# Get an e-mail when the instance status check alarm fires:
# alert_email = "you@example.com"
