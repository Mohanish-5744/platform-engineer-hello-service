# Installed to /etc/systemd/system/hello.service
[Unit]
Description=hello-service HTTP app
After=network-online.target
Wants=network-online.target
# Keep restarting forever; RestartSec stops it becoming a tight loop.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/hello-service/app.py
EnvironmentFile=-/etc/hello-service/env
Environment=HOST=0.0.0.0 PORT=80 PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
Restart=always
RestartSec=3
TimeoutStopSec=10

# Run as a throwaway non-root user that may bind port 80 and nothing more.
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Sandbox: read-only OS, no home dirs, private /tmp and /dev.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes

# t3.micro has 1 GiB RAM; don't let this app take the box down.
MemoryMax=128M

[Install]
WantedBy=multi-user.target
